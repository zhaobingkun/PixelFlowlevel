{
  "manifest_version": 3,
  "name": "Safe Comment Filler (Manual Submit)",
  "version": "1.0.0",
  "description": "Import comment rows from Excel-exported CSV and fill forms on approved pages. Never auto-submits.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Safe Comment Filler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
